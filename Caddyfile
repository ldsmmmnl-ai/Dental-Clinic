{
    admin off
    auto_https off
}

:8080 {
    root * /app

    # CONFIDENTIALITY: never serve internal files (config, source libs, logs, SQL, docs, hidden files).
    # This block must stay FIRST so it wins over the static-file handlers below.
    @private {
        path /.* /vendor/* /includes/* /logs/* /database/* /docs/* /CHAPTER* /composer.* /README.md /Dockerfile /Caddyfile *.sql *.log *.md *.lock *.env
    }
    handle @private {
        respond 403
    }

    # Compress everything — zstd first (faster), gzip as fallback
    encode {
        zstd
        gzip 6
        minimum_length 512
    }

    # Bootstrap + fonts — bundled at build time, never change → 1 year
    @immutable {
        path *.woff *.woff2 *.ttf *.eot
    }
    handle @immutable {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @bootstrap {
        path /assets/css/bootstrap* /assets/js/bootstrap*
    }
    handle @bootstrap {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Your own CSS/JS — 7 days (refreshes on redeploy)
    @static {
        path *.css *.js
    }
    handle @static {
        header Cache-Control "public, max-age=604800, must-revalidate"
        file_server
    }

    # Images
    @images {
        path *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp
    }
    handle @images {
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # Block PHP execution in the uploads directory (.htaccess is ignored by Caddy)
    @uploads_php {
        path /uploads/*.php /uploads/*.phtml /uploads/*.php5 /uploads/*.phar /uploads/*.pl /uploads/*.sh
    }
    respond @uploads_php 403

    php_server
}
